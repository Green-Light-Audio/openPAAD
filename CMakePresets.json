{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "evkb-rt1170",
      "displayName": "Firmware: NXP MIMXRT1170-EVKB (Cortex-M7)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/evkb-rt1170",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "OPENPAAD_BOARD": "evkb-rt1170",
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "host",
      "displayName": "Host: unit tests and simulation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "OPENPAAD_BOARD": "host",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "conformance",
      "displayName": "Host: ATDECC conformance harness (fetches la_avdecc, test only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/conformance",
      "cacheVariables": {
        "OPENPAAD_BOARD": "host",
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENPAAD_CONFORMANCE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "evkb-rt1170", "configurePreset": "evkb-rt1170" },
    { "name": "host", "configurePreset": "host" },
    { "name": "conformance", "configurePreset": "conformance", "targets": ["openpaad-sim", "openpaad-conformance"] }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } },
    {
      "name": "conformance",
      "configurePreset": "conformance",
      "output": { "outputOnFailure": true, "verbosity": "verbose" },
      "filter": { "include": { "label": "conformance" } }
    }
  ]
}
